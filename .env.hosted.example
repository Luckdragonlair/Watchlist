# Copy to .env.hosted.local after creating the FREE Spark project.
# Firebase web configuration is public client configuration, never an admin key.
VITE_FIREBASE_API_KEY=REPLACE_FROM_FIREBASE_WEB_CONFIG
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_PROJECT_ID
VITE_FIREBASE_APP_ID=REPLACE_FROM_FIREBASE_WEB_CONFIG
# Stable UID from Authentication > Users after signing in to your Google account.
VITE_FIREBASE_OWNER_UID=
