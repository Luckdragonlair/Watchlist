{
  "name": "watchlist",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/build-service-worker.mjs",
    "build:hosted": "tsc --noEmit && node scripts/build-hosted.mjs && node scripts/check-hosted-build.mjs",
    "start": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "test:rules": "node scripts/run-rules-tests.mjs"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "firebase": "^13.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.0",
    "firebase-tools": "^15.35.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
